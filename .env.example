# ARES System Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ARES_SECRET_KEY=ares-super-secure-jwt-secret-key-2026-production

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
